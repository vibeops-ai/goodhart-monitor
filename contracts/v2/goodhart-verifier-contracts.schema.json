            },
            "authority_bundle_refs": {
              "type": "array",
              "items": { "$ref": "#/$defs/VersionedRef" }
            },
            "failure_mode_profile_refs": {
              "type": "array",
              "items": { "$ref": "#/$defs/VersionedRef" }
