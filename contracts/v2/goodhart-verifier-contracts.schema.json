            "decision_table": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/DecisionRule" }
            },
            "dispositions": {
              "type": "object",
              "additionalProperties": false,
              "required": ["pass", "flag", "hold", "unable_to_verify"],
